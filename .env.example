# Soundfolio — copy to .env.local and fill in. Never commit .env files.
#
# --- MongoDB Atlas (required) ---
# Rotate any URI that has ever been shared in chat/logs before using it here.
# Example: mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Soundfolio
MONGODB_URI=""
MONGODB_DB="soundfolio"

# --- Last.fm (required for scrobble sync) ---
# API key: https://www.last.fm/api/account/create
# Username: the name in your profile URL — https://www.last.fm/user/THIS_PART
LASTFM_API_KEY=""
LASTFM_USER=""
# Fallback track length (ms) when Last.fm has no duration metadata. Default: 180000 (3 min)
# LASTFM_DEFAULT_DURATION_MS="240000"

# IANA timezone for charts (hour of day, day of week, daily buckets). Required on hosts
# where the server runs in UTC — set to where you actually listen, e.g. America/New_York
# TIMEZONE="America/Los_Angeles"

# Optional: protect /me routes with a secret key (query ?key=... or cookie)
AUTH_KEY=""

# Optional Spotify recently played sync
CRON_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# Optional Discogs artist artwork backfill
DISCOGS_TOKEN=""
