# Soundfolio — copy to .env.local and fill in. Never commit .env files.
#
# --- MongoDB Atlas (optional — one-time migration source only) ---
# Only needed to run: npm run db:migrate-firestore
# MONGODB_URI=""
# MONGODB_DB="soundfolio"

# --- Firebase (required for public multi-user auth) ---
# Web client config from Firebase Console > Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="odev-b10e2"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin (server) — service account JSON string OR individual fields
# Firebase Console > Project settings > Service accounts > Generate new private key
# Use the default firebase-adminsdk account (do not create a custom GCP service account).
# If you see "PERMISSION_DENIED" on sign-in, in Google Cloud IAM grant that account:
#   - Cloud Datastore User
#   - Service Account Token Creator
# Also create Firestore Database in Firebase Console (Build > Firestore) if missing.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# --- Last.fm (required for scrobble sync) ---
# Shared app API key: https://www.last.fm/api/account/create
# Per-user Last.fm usernames are stored in Firestore after onboarding.
LASTFM_API_KEY=""
LASTFM_USER=""
# LEGACY_USER_ID="" assign existing MongoDB rows to this uid during migration
# Fallback track length (ms) when Last.fm has no catalog duration. Default: 180000 (3 min)
# LASTFM_DEFAULT_DURATION_MS="180000"

# Optional fallback IANA timezone when the browser cookie is not set yet (SSR).
# Normally the app uses your browser zone (soundfolio_tz cookie). On Vercel the server is UTC.
# TIMEZONE="America/Los_Angeles"

# Optional legacy admin access (query ?key=... or Bearer token). Leave empty for Firebase-only auth.
AUTH_KEY=""

# Migrate existing MongoDB streams (no userId) to your Firebase account:
# Option A — auto-claim when this email signs in:
# LEGACY_OWNER_EMAIL="you@example.com"
# Option B — assign directly by Firebase uid:
# LEGACY_USER_ID="your_firebase_uid"
# Manual: npm run db:migrate-firestore -- --uid=your_firebase_uid

# Optional Spotify recently played sync
CRON_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# Optional Discogs artist artwork backfill
DISCOGS_TOKEN=""
