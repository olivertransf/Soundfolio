rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /streams/{streamId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /demo_streams/{streamId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
